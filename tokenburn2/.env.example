# TokenBurn 2.0 — serverless proxy environment variables.
# Copy to .env and set on your host (server-side only). NEVER commit real keys,
# and NEVER expose these to the browser.

# Enables exact Anthropic token counts via the proxy.
ANTHROPIC_API_KEY=

# Enables exact Gemini token counts via the proxy.
GEMINI_API_KEY=

# Exact origin allowed by the proxy's CORS, e.g. https://tokenburn.example.com
APP_ORIGIN=
