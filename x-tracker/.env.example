# ─────────────────────────────────────────────────────────────────────────────
# X Tracker configuration
# Copy to `.env.local` and edit. EVERY variable has a sensible default, so the
# app runs out of the box with zero config (PROVIDER=mock).
# ─────────────────────────────────────────────────────────────────────────────

# Which data source to use: "mock" | "aggregator" | "xapi".
# - mock        : generated demo data, no keys required (DEFAULT).
# - aggregator  : a third-party aggregator REST API (set AGG_* below).
# - xapi        : the official X API v2 (set X_BEARER_TOKEN below).
# If a non-mock provider is selected but its keys are missing, the app logs a
# warning and falls back to mock instead of crashing.
PROVIDER=mock

# The X / Twitter account to track. With or without a leading "@".
TARGET_HANDLE=elonmusk

# Seconds between poll cycles. "Real time" = this interval (polling, not push).
POLL_INTERVAL_SECONDS=45

# ── AggregatorProvider (PROVIDER=aggregator) ────────────────────────────────
# Base URL of your aggregator's REST API, e.g. https://api.twitterapi.io
# The exact endpoint path + field mapping live in src/lib/providers/aggregator.ts
# (look for the ">>> PLUG IN HERE" comments).
AGG_BASE_URL=
# API key for the aggregator (sent as X-API-Key by default — adjust in adapter).
AGG_API_KEY=

# ── XApiProvider (PROVIDER=xapi) ─────────────────────────────────────────────
# App-only Bearer token for the official X API v2. The adapter resolves the
# handle -> user id, then calls GET /2/users/:id/tweets.
# NOTE: lower X API tiers are heavily rate-limited; widen POLL_INTERVAL_SECONDS.
X_BEARER_TOKEN=
